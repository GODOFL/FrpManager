<Window x:Class="FrpManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrpManager" Height="820" Width="1200"
        MinHeight="640" MinWidth="920"
        Background="{StaticResource BgMainBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="F" Foreground="White" FontSize="18" FontWeight="Bold"
                                   FontFamily="Segoe UI Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FrpManager" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource S_AppSubtitle}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLang" Style="{StaticResource SecondaryBtn}"
                            Content="{DynamicResource S_LangBtn}"
                            Click="Btn_ToggleLang" Margin="0,0,12,0" FontFamily="Segoe UI Semibold"/>
                    <Button Style="{StaticResource SecondaryBtn}" Click="Btn_Open" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource S_Open}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="Btn_Save" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource S_Save}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStart" Style="{StaticResource GreenBtn}" Click="Btn_Start">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtStartIcon" Text="▶" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock x:Name="TxtStartLabel" Text="{DynamicResource S_StartFrpc}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Body ═════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="220" MaxWidth="380"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ───────────────────────────────────────────────── -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="70"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0.5*" MinHeight="55"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Proxy header -->
                    <Border Grid.Row="0" Padding="12,10,12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource S_ProxyRules}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtProxyCount"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryBtn}"
                                    Padding="9,5" Click="Btn_AddProxy">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,3,0"/>
                                    <TextBlock Text="{DynamicResource S_Add}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Proxy list -->
                    <ListBox Grid.Row="1" x:Name="ProxyList"
                             Background="Transparent" BorderThickness="0" Padding="8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ProxyListItem}"
                             SelectionChanged="ProxyList_Changed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="5" Padding="5,2"
                                            Margin="0,0,8,0" Background="{StaticResource AccentLightBrush}">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   Foreground="{StaticResource AccentDarkBrush}"
                                                   FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource DangerBtn}"
                                            Content="✕" Tag="{Binding}" Click="Btn_DeleteProxy"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Visitor header -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="12,10,12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                        Background="{StaticResource AccentTealLightBrush}">
                                    <TextBlock Text="vis" Foreground="{StaticResource AccentTealBrush}"
                                               FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Text="{DynamicResource S_VisitorRules}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtVisitorCount"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryBtn}"
                                    Padding="9,5" Click="Btn_AddVisitor"
                                    Background="{StaticResource AccentTealBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,0,3,0"/>
                                    <TextBlock Text="{DynamicResource S_Add}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Visitor list -->
                    <ListBox Grid.Row="3" x:Name="VisitorList"
                             Background="Transparent" BorderThickness="0" Padding="8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource VisitorListItem}"
                             SelectionChanged="VisitorList_Changed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="5" Padding="5,2"
                                            Margin="0,0,8,0" Background="{StaticResource AccentTealLightBrush}">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   Foreground="{StaticResource AccentTealBrush}"
                                                   FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource DangerBtn}"
                                            Content="✕" Tag="{Binding}" Click="Btn_DeleteVisitor"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Templates -->
                    <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S_ProxyTemplates}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplTcp}"   Click="T_Tcp"   Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplSsh}"   Click="T_Ssh"   Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplRdp}"   Click="T_Rdp"   Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplHttp}"  Click="T_Web"   Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplHttps}" Click="T_Https" Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplUdp}"   Click="T_Udp"   Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplMc}"    Click="T_Mc"    Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplStcp}"  Click="T_Stcp"  Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplXtcp}"  Click="T_Xtcp"  Margin="0,0,4,3"/>
                                <Button Style="{StaticResource IconBtn}" Content="{DynamicResource S_TplSudp}"  Click="T_Sudp"  Margin="0,0,4,3"/>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource S_VisitorTemplates}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <WrapPanel>
                                <Button Style="{StaticResource TealIconBtn}" Content="{DynamicResource S_TplStcpVisitor}"  Click="T_StcpVisitor"         Margin="0,0,4,3"/>
                                <Button Style="{StaticResource TealIconBtn}" Content="{DynamicResource S_TplXtcpVisitor}"  Click="T_XtcpVisitor"         Margin="0,0,4,3"/>
                                <Button Style="{StaticResource TealIconBtn}" Content="{DynamicResource S_TplXtcpFallback}" Click="T_XtcpWithFallback"    Margin="0,0,4,3"/>
                                <Button Style="{StaticResource TealIconBtn}" Content="{DynamicResource S_TplStcpFallback}" Click="T_XtcpFallbackVisitor" Margin="0,0,4,3"/>
                                <Button Style="{StaticResource TealIconBtn}" Content="{DynamicResource S_TplSudpVisitor}"  Click="T_SudpVisitor"         Margin="0,0,4,3"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <!-- ── Right tabs ─────────────────────────────────────────────── -->
            <TabControl Grid.Column="2" x:Name="MainTabs" Style="{StaticResource SkyTabControl}">

                <!-- Tab Config library -->
                <TabItem x:Name="TabTomlLib" Header="{DynamicResource S_TabTomlLib}"
                         Style="{StaticResource SkyTabItem}">
                    <Grid Background="{StaticResource BgMainBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S_TomlLibTitle}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtTomlDir"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}"
                                        Content="{DynamicResource S_RefreshList}"
                                        Click="Btn_RefreshTomlList"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <StackPanel x:Name="TomlFilePanel">
                                <TextBlock x:Name="TxtTomlHint"
                                           Text="{DynamicResource S_TomlHintEmpty}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" HorizontalAlignment="Center" Margin="0,30"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab Editor -->
                <TabItem x:Name="TabEditor" Header="{DynamicResource S_TabEditor}"
                         Style="{StaticResource SkyTabItem}">
                    <Grid Background="{StaticResource BgMainBrush}">
                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔌" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="{DynamicResource S_EmptyState}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Proxy editor -->
                        <ScrollViewer x:Name="ProxyEditorPanel" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" Margin="28,20,28,12">
                            <StackPanel MaxWidth="640">
                                <TextBlock x:Name="TxtProxyTitle"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                                <!-- Basic -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_BasicInfo}" Style="{StaticResource SectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource S_ProxyName}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="F_Name" Style="{StaticResource SkyTextBox}"
                                                         Tag="{DynamicResource S_ProxyNamePh}"
                                                         TextChanged="Proxy_FieldChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource S_ProxyType}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="F_Type" Style="{StaticResource SkyComboBox}"
                                                          SelectionChanged="Proxy_TypeChanged">
                                                    <ComboBoxItem Content="tcp" IsSelected="True"/>
                                                    <ComboBoxItem Content="udp"/>
                                                    <ComboBoxItem Content="http"/>
                                                    <ComboBoxItem Content="https"/>
                                                    <ComboBoxItem Content="stcp"/>
                                                    <ComboBoxItem Content="xtcp"/>
                                                    <ComboBoxItem Content="sudp"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- Local service -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_LocalService}" Style="{StaticResource SectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource S_LocalIpLabel}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="F_LocalIp" Style="{StaticResource SkyTextBox}"
                                                         Tag="127.0.0.1" TextChanged="Proxy_FieldChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource S_LocalPortLabel}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="F_LocalPort" Style="{StaticResource SkyTextBox}"
                                                         Tag="80" TextChanged="Proxy_FieldChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- TCP/UDP remote port -->
                                <Border x:Name="CardRemote" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_RemotePortSection}" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{DynamicResource S_RemotePortLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="F_RemotePort" Style="{StaticResource SkyTextBox}"
                                                 Tag="{DynamicResource S_RemotePortPh}"
                                                 TextChanged="Proxy_FieldChanged"/>
                                    </StackPanel>
                                </Border>
                                <!-- HTTP/HTTPS domains -->
                                <Border x:Name="CardHttp" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_DomainSection}" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{DynamicResource S_CustomDomainsLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="F_Domains" Style="{StaticResource SkyTextBox}"
                                                 Tag="{DynamicResource S_CustomDomainsPh}"
                                                 Margin="0,0,0,12" TextChanged="Proxy_FieldChanged"/>
                                        <TextBlock Text="{DynamicResource S_SubdomainLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="F_Subdomain" Style="{StaticResource SkyTextBox}"
                                                 Tag="{DynamicResource S_SubdomainPh}"
                                                 TextChanged="Proxy_FieldChanged"/>
                                    </StackPanel>
                                </Border>
                                <!-- STCP/XTCP/SUDP secret -->
                                <Border x:Name="CardSecret" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_SecretSection}" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{DynamicResource S_SecretKeyLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="F_Sk" Style="{StaticResource SkyTextBox}"
                                                 Tag="{DynamicResource S_SecretKeyPh}"
                                                 TextChanged="Proxy_FieldChanged"/>
                                    </StackPanel>
                                </Border>
                                <!-- Transport options -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_TransportOptions}" Style="{StaticResource SectionLabel}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="F_Encrypt" Style="{StaticResource SkyCheckBox}"
                                                      Content="{DynamicResource S_UseEncryption}"
                                                      Margin="0,0,28,0"
                                                      Checked="Proxy_CheckChanged" Unchecked="Proxy_CheckChanged"/>
                                            <CheckBox x:Name="F_Compress" Style="{StaticResource SkyCheckBox}"
                                                      Content="{DynamicResource S_UseCompression}"
                                                      Checked="Proxy_CheckChanged" Unchecked="Proxy_CheckChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Visitor [vis] editor -->
                        <ScrollViewer x:Name="VisitorEditorPanel" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" Margin="28,20,28,12">
                            <StackPanel MaxWidth="640">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border CornerRadius="6" Padding="8,3" Margin="0,0,10,0"
                                            Background="{StaticResource AccentTealLightBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="[vis]" Foreground="{StaticResource AccentTealBrush}"
                                                   FontSize="13" FontWeight="Bold" FontFamily="Consolas"/>
                                    </Border>
                                    <TextBlock x:Name="TxtVisitorTitle"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Visitor basic -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_BasicInfo}" Style="{StaticResource SectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource S_VisitorName}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="V_Name" Style="{StaticResource SkyTextBox}"
                                                         Tag="{DynamicResource S_VisitorNamePh}"
                                                         TextChanged="Visitor_FieldChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource S_VisitorType}" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="V_Type" Style="{StaticResource SkyComboBox}"
                                                          SelectionChanged="Visitor_TypeChanged">
                                                    <ComboBoxItem Content="stcp" IsSelected="True"/>
                                                    <ComboBoxItem Content="xtcp"/>
                                                    <ComboBoxItem Content="sudp"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- Server proxy -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_ServerProxy}" Style="{StaticResource SectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource S_ServerNameLabel}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="V_ServerName" Style="{StaticResource SkyTextBox}"
                                                         Tag="{DynamicResource S_ServerNamePh}"
                                                         TextChanged="Visitor_FieldChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource S_ServerUserLabel}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="V_ServerUser" Style="{StaticResource SkyTextBox}"
                                                         Tag="{DynamicResource S_ServerUserPh}"
                                                         TextChanged="Visitor_FieldChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- Bind -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_LocalBind}" Style="{StaticResource SectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource S_BindAddrLabel}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="V_BindAddr" Style="{StaticResource SkyTextBox}"
                                                         Tag="127.0.0.1" TextChanged="Visitor_FieldChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource S_BindPortLabel}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="V_BindPort" Style="{StaticResource SkyTextBox}"
                                                         Tag="{DynamicResource S_BindPortPh}"
                                                         TextChanged="Visitor_FieldChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- Visitor secret key -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_SecretOptional}" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{DynamicResource S_SecretKeyDesc}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="V_Sk" Style="{StaticResource SkyTextBox}"
                                                 Tag="{DynamicResource S_SecretVisitorPh}"
                                                 TextChanged="Visitor_FieldChanged"/>
                                    </StackPanel>
                                </Border>
                                <!-- XTCP P2P card (only visible for xtcp type) -->
                                <Border x:Name="CardXtcp" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_XtcpSection}"
                                                   Style="{StaticResource SectionLabel}"/>
                                        <CheckBox x:Name="V_KeepTunnelOpen" Style="{StaticResource SkyCheckBox}"
                                                  Content="{DynamicResource S_KeepTunnelOpen}"
                                                  Margin="0,0,0,16"
                                                  Checked="Visitor_CheckChanged" Unchecked="Visitor_CheckChanged"/>
                                        <TextBlock Text="{DynamicResource S_FallbackSection}"
                                                   Style="{StaticResource SectionLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource S_FallbackToLabel}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="V_FallbackTo" Style="{StaticResource SkyTextBox}"
                                                         Tag="{DynamicResource S_FallbackToPh}"
                                                         TextChanged="Visitor_FieldChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{DynamicResource S_FallbackTimeoutLabel}" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="V_FallbackTimeoutMs" Style="{StaticResource SkyTextBox}"
                                                         Tag="{DynamicResource S_FallbackTimeoutPh}"
                                                         TextChanged="Visitor_FieldChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- Tab Server config -->
                <TabItem x:Name="TabServer" Header="{DynamicResource S_TabServer}"
                         Style="{StaticResource SkyTabItem}">
                    <ScrollViewer Background="{StaticResource BgMainBrush}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20,28,12" MaxWidth="640">
                            <TextBlock Text="{DynamicResource S_ServerConfigTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                            <!-- frpc path -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_FrpcPathSection}" Style="{StaticResource SectionLabel}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbFrpcPath" Style="{StaticResource SkyComboBox}"
                                                  IsEditable="True" SelectionChanged="FrpcPath_Changed"/>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}"
                                                Content="{DynamicResource S_Browse}"
                                                Click="Btn_BrowseFrpc" Padding="12,7"/>
                                        <Button Grid.Column="4" Style="{StaticResource PrimaryBtn}"
                                                Content="{DynamicResource S_AutoScan}"
                                                Click="Btn_ScanFrpc" Padding="12,7"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtFrpcPathHint"
                                               Text="{DynamicResource S_FrpcPathHintEmpty}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <!-- Connection -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_ConnectionParams}" Style="{StaticResource SectionLabel}"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource S_ServerAddrLabel}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="S_Addr" Style="{StaticResource SkyTextBox}"
                                                     Tag="{DynamicResource S_ServerAddrPh}"
                                                     TextChanged="Server_FieldChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource S_PortLabel}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="S_Port" Style="{StaticResource SkyTextBox}"
                                                     Tag="7000" TextChanged="Server_FieldChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource S_AuthTokenLabel}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="S_Token" Style="{StaticResource SkyTextBox}"
                                             Tag="{DynamicResource S_AuthTokenPh}"
                                             TextChanged="Server_FieldChanged"/>
                                </StackPanel>
                            </Border>
                            <!-- Security -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_SecuritySection}" Style="{StaticResource SectionLabel}"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource S_AuthMethodLabel}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="S_AuthMethod" Style="{StaticResource SkyComboBox}"
                                                      SelectionChanged="Server_AuthChanged">
                                                <ComboBoxItem Content="{DynamicResource S_AuthNone}" IsSelected="True"/>
                                                <ComboBoxItem Content="token"/>
                                                <ComboBoxItem Content="oidc"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{DynamicResource S_LogLevelLabel}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="S_LogLevel" Style="{StaticResource SkyComboBox}"
                                                      SelectionChanged="Server_FieldChanged">
                                                <ComboBoxItem Content="trace"/>
                                                <ComboBoxItem Content="debug"/>
                                                <ComboBoxItem Content="info" IsSelected="True"/>
                                                <ComboBoxItem Content="warn"/>
                                                <ComboBoxItem Content="error"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="TokenPanel" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource S_AuthTokenLabel}"
                                                   Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                                        <TextBox x:Name="S_TokenExtra" Style="{StaticResource SkyTextBox}"
                                                 Tag="{DynamicResource S_AuthTokenPh}"
                                                 TextChanged="Server_FieldChanged"/>
                                    </StackPanel>
                                    <CheckBox x:Name="S_Tls" Style="{StaticResource SkyCheckBox}"
                                              Content="{DynamicResource S_TlsEnableCheck}"
                                              Margin="0,10,0,0"
                                              Checked="Server_CheckChanged" Unchecked="Server_CheckChanged"/>
                                </StackPanel>
                            </Border>
                            <!-- STUN server (for XTCP) -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_StunSection}" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{DynamicResource S_StunDesc}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="S_StunServer" Style="{StaticResource SkyTextBox}"
                                             Tag="{DynamicResource S_StunPh}"
                                             TextChanged="Server_FieldChanged"/>
                                </StackPanel>
                            </Border>
                            <!-- Log file -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource S_LogFileSection}" Style="{StaticResource SectionLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="S_LogFile" Style="{StaticResource SkyTextBox}"
                                                 Tag="{DynamicResource S_LogFilePh}"
                                                 TextChanged="Server_FieldChanged"/>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}"
                                                Content="{DynamicResource S_Browse}" Click="Btn_BrowseLog"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: Config preview -->
                <TabItem x:Name="TabPreview" Header="{DynamicResource S_TabPreview}"
                         Style="{StaticResource SkyTabItem}">
                    <Grid Background="{StaticResource BgMainBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource S_PreviewTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                                <Button Style="{StaticResource SecondaryBtn}" Content="{DynamicResource S_Refresh}"
                                        Click="Btn_Refresh" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SecondaryBtn}" Content="{DynamicResource S_CopyAll}"
                                        Click="Btn_CopyAll" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="{DynamicResource S_ExportFrpc}"
                                        Click="Btn_ExportFrpc" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource SecondaryBtn}" Content="{DynamicResource S_ExportFrps}"
                                        Click="Btn_ExportFrps"/>
                            </StackPanel>
                        </Border>
                        <TextBox Grid.Row="1" x:Name="PreviewBox"
                                 Background="#F0F8FF" Foreground="#1A5080"
                                 FontFamily="Cascadia Code, Consolas, Courier New" FontSize="13"
                                 BorderThickness="0" Padding="22" IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                    </Grid>
                </TabItem>

                <!-- Tab Terminal -->
                <TabItem x:Name="TabTerminal" Header="{DynamicResource S_TabTerminal}"
                         Style="{StaticResource SkyTabItem}">
                    <Grid Background="{StaticResource TerminalBgBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0A1520"
                                BorderBrush="#1A3050" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="TermDot" Width="9" Height="9" Fill="#555" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtTermStatus"
                                               Text="{DynamicResource S_FrpcNotRunning}"
                                               Foreground="#5A8AAA" FontSize="12" FontFamily="Consolas"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="Btn_ClearTerminal"
                                        Content="{DynamicResource S_Clear}"
                                        Background="Transparent" Foreground="#5A8AAA"
                                        BorderThickness="0" Padding="8,4" Cursor="Hand"
                                        FontSize="12" FontFamily="Consolas"/>
                            </Grid>
                        </Border>
                        <RichTextBox Grid.Row="1" x:Name="TerminalBox"
                                     Background="{StaticResource TerminalBgBrush}"
                                     Foreground="{StaticResource TerminalFgBrush}"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12.5" BorderThickness="0" Padding="14,10"
                                     IsReadOnly="True" IsDocumentEnabled="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto">
                            <FlowDocument PagePadding="0" PageWidth="9999">
                                <FlowDocument.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="LineHeight" Value="18"/>
                                    </Style>
                                </FlowDocument.Resources>
                            </FlowDocument>
                        </RichTextBox>
                    </Grid>
                </TabItem>

                <!-- Tab Download -->
                <TabItem x:Name="TabDownload" Header="{DynamicResource S_TabDownload}"
                         Style="{StaticResource SkyTabItem}">
                    <Grid Background="{StaticResource BgMainBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S_DownloadTitle}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtRelInfo"
                                               Text="{DynamicResource S_DownloadHint}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryBtn}"
                                            Content="{DynamicResource S_CheckUpdate}"
                                            Click="Btn_CheckUpdate" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource SecondaryBtn}"
                                            Content="{DynamicResource S_OpenGithub}"
                                            Click="Btn_OpenGithub"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <StackPanel x:Name="AssetPanel">
                                <TextBlock x:Name="TxtAssetHint"
                                           Text="{DynamicResource S_AssetHint}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" Margin="0,20" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" x:Name="ProgressPanel"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="16,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtDlFile"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock x:Name="TxtDlPct" HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentDarkBrush}"
                                               FontSize="12" FontFamily="Consolas"/>
                                </Grid>
                                <ProgressBar x:Name="DlProgress"
                                             Style="{StaticResource SkyProgress}" Maximum="100"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ══ Status bar ════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="{DynamicResource S_Ready}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCounts" Grid.Column="1"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#C0C0C0" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtFrpStatus" Text="{DynamicResource S_FrpcNotRunning}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>